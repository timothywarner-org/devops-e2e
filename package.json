{
  "name": "devops-e2e",
  "version": "1.0.0",
  "description": "Simple yet effective end-to-end CI/CD process to showcase current-gen DevOps processes and principles.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "docker:build": "docker build -t devops-e2e .",
    "docker:run": "docker run -p 3000:3000 devops-e2e"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "node",
    "express",
    "docker",
    "azure",
    "aks",
    "teaching",
    "learning"
  ],
  "author": "Timothy Warner Organization",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^8.57.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
