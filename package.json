{
  "name": "devops-e2e",
  "version": "1.0.0",
  "description": "End-to-end DevOps teaching application demonstrating CI/CD best practices",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "docker:build": "docker build -t devops-e2e .",
    "docker:run": "docker run -p 3000:3000 devops-e2e"
  },
  "keywords": [
    "devops",
    "ci/cd",
    "docker",
    "kubernetes",
    "azure",
    "teaching"
  ],
  "author": "DevOps Teaching Team",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "ejs": "^3.1.10",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "nodemon": "^3.1.0",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 75,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}