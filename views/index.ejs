<% var body = `
<div class="jumbotron">
    <h1 class="display-4">Welcome to DevOps E2E Demo</h1>
    <p class="lead">A comprehensive teaching application demonstrating modern CI/CD practices and cloud deployment strategies.</p>
    <hr class="my-4">
    <p>Version: <span class="badge bg-success">${version}</span></p>
</div>

<div class="row mt-5">
    <div class="col-md-12">
        <h2>Key Features</h2>
        <div class="row">
            ${features.map(feature => `
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">${feature}</h5>
                    </div>
                </div>
            </div>
            `).join('')}
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <h3>Quick Actions</h3>
        <div class="list-group">
            <a href="/api/status" class="list-group-item list-group-item-action">Check API Status</a>
            <a href="/api/metrics" class="list-group-item list-group-item-action">View System Metrics</a>
            <a href="/health" class="list-group-item list-group-item-action">Health Dashboard</a>
            <a href="/about" class="list-group-item list-group-item-action">Learn More</a>
        </div>
    </div>
    <div class="col-md-6">
        <h3>DevOps Pipeline Status</h3>
        <div class="card">
            <div class="card-body">
                <p><span class="badge bg-success">Build: Passing</span></p>
                <p><span class="badge bg-success">Tests: 100% Coverage</span></p>
                <p><span class="badge bg-info">Container: Ready</span></p>
                <p><span class="badge bg-primary">Deployment: Kubernetes</span></p>
            </div>
        </div>
    </div>
</div>
`; %>
<%- include('layout', { title: title, body: body }) %>